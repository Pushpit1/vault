{
  "compilerOptions": {
    "target": "ES2022",

    "module": "CommonJS",

    "rootDir": ".",

    "outDir": "./dist",

    "strict": true,

    "esModuleInterop": true,

    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,

    "resolveJsonModule": true
  },

  "include": [
    "src",
    "tests",
    "vitest.config.ts"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}